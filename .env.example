# MySQL 8 DSN (go-sql-driver/mysql format). parseTime+loc are required
# so DATETIME columns round-trip as UTC time.Time.
MYSQL_DSN=root:change-me@tcp(127.0.0.1:3306)/flowhub?parseTime=true&loc=UTC&charset=utf8mb4
HUB_LISTEN=127.0.0.1:8790
# Dashboard SPA origin — the ONLY origin allowed by CORS (SPEC §9).
DASHBOARD_ORIGIN=http://localhost:5173
# Where migrations/*.sql live, relative to backend/ (hubd's working directory).
MIGRATIONS_DIR=migrations
SESSION_SECRET=change-me-256-bit-random
# First-boot platform admin (house tenant id 1, role SUPERADMIN) — consumed once, then rotate
PLATFORM_ADMIN_USERNAME=platform-admin
PLATFORM_ADMIN_PASSWORD=change-me
PLATFORM_ADMIN_MOBILE=+91XXXXXXXXXX
# SMS (production only; ConsoleSender used when unset). TRAI DLT
# registration is a prerequisite — see SPEC.md §6.4.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=
